<?xml version="1.0" encoding="utf-8"?>
<com.example.animelib.ui.PortraitCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVideoItemShortGrid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg_color"
    app:strokeWidth="1dp"
    app:strokeColor="#1AFFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Video Thumbnail -->
        <ImageView
            android:id="@+id/ivVideoThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image"
            android:contentDescription="Short Video Thumbnail" />

        <!-- TOP BAR: Selection Badge & Watch % Progress on Top Left, NEW Tag on Top Right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="5dp">

            <!-- TOP LEFT: Selection Badge & Watch Progress % -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Selection Badge (Playlist Creation Mode) -->
                <TextView
                    android:id="@+id/tvSelectionBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_m3_selected_pill"
                    android:textColor="@color/white_color"
                    android:textSize="10sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Watch Progress Percentage on TOP LEFT -->
                <TextView
                    android:id="@+id/tvWatchProgressStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_video_thumbnail_badge"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/white_color"
                    android:textSize="8.5sp"
                    android:fontFamily="@font/open_sans_bold"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- TOP RIGHT: NEW Tag ("НОВОЕ") -->
            <TextView
                android:id="@+id/tvVideoNewTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_new_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp"
                android:textColor="@color/accent_color"
                android:textSize="8.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:text="НОВОЕ"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- BOTTOM BAR: Duration on Bottom Left, Options Button on Bottom Right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="5dp"
            android:paddingBottom="5dp">

            <!-- BOTTOM LEFT: Duration -->
            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_video_thumbnail_badge"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:text="00:00"
                android:textColor="@color/white_color"
                android:textSize="9.5sp"
                android:fontFamily="@font/open_sans_bold"
                android:includeFontPadding="false" />

            <!-- BOTTOM RIGHT: Options Button (3 dots) -->
            <ImageButton
                android:id="@+id/btnVideoMore"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/white_color"
                android:contentDescription="Опции видео"
                android:padding="4dp" />

        </RelativeLayout>

        <!-- Bottom M3 Progress Indicator -->
        <com.example.animelib.ui.M3LinearProgressIndicator
            android:id="@+id/pbWatchProgress"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            app:m3TrackHeight="3.5dp"
            app:m3GapSize="0dp"
            app:m3ShowStopDot="false"
            app:m3IndicatorColor="@color/accent_color"
            app:m3TrackColor="@android:color/transparent"
            android:visibility="gone" />

        <!-- Hidden compatibility views for VideoViewHolder -->
        <TextView
            android:id="@+id/tvVideoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVideoSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVideoExtensionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVideoFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </FrameLayout>

</com.example.animelib.ui.PortraitCardView>
