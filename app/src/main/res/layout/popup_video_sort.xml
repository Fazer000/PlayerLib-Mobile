<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sort_popup"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- По дате (новые) -->
    <LinearLayout
        android:id="@+id/popup_sort_date_desc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_date_desc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sort_clock"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="По дате (новые)" />

        <TextView
            android:id="@+id/tv_title_date_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="По дате (новые)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_date_desc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- По дате (старые) -->
    <LinearLayout
        android:id="@+id/popup_sort_date_asc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_date_asc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sort_clock"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="По дате (старые)" />

        <TextView
            android:id="@+id/tv_title_date_asc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="По дате (старые)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_date_asc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- По названию (А–Я) -->
    <LinearLayout
        android:id="@+id/popup_sort_name_asc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_name_asc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sort_text"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="По имени (А–Я)" />

        <TextView
            android:id="@+id/tv_title_name_asc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="По имени (А–Я)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_name_asc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- По названию (Я–А) -->
    <LinearLayout
        android:id="@+id/popup_sort_name_desc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_name_desc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sort_text"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="По имени (Я–А)" />

        <TextView
            android:id="@+id/tv_title_name_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="По имени (Я–А)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_name_desc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- По размеру (убывание) -->
    <LinearLayout
        android:id="@+id/popup_sort_size_desc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_size_desc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sort_size"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="По размеру (убывание)" />

        <TextView
            android:id="@+id/tv_title_size_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="По размеру (большие)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_size_desc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- По размеру (возрастание) -->
    <LinearLayout
        android:id="@+id/popup_sort_size_asc"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_size_asc"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sort_size"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="По размеру (возрастание)" />

        <TextView
            android:id="@+id/tv_title_size_asc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="По размеру (малые)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_size_asc"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- Разделитель -->
    <View
        android:id="@+id/divider_view_mode"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginVertical="4dp" />

    <!-- Вид: Списком -->
    <LinearLayout
        android:id="@+id/popup_view_mode_list"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_view_list"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_view_list"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="Списком" />

        <TextView
            android:id="@+id/tv_title_view_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Списком"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_view_list"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

    <!-- Вид: Сеткой (3 колонки) -->
    <LinearLayout
        android:id="@+id/popup_view_mode_grid"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_popup_item_ripple">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon_view_grid"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_view_grid"
            app:tint="@color/primary_text_color"
            android:layout_marginEnd="10dp"
            android:contentDescription="Сеткой (3 колонки)" />

        <TextView
            android:id="@+id/tv_title_view_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сеткой (3 колонки)"
            android:textColor="@color/primary_text_color"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans_semibold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_check_view_grid"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent_color"
            android:visibility="gone"
            android:contentDescription="Выбрано" />
    </LinearLayout>

</LinearLayout>
