<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Video List SwipeRefresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingTop="96dp"
            android:paddingBottom="180dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Empty State (Encapsulated exclusively in Explorer) -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_search"
            app:tint="@color/player_item_inactive_text"
            android:contentDescription="Empty" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Видео не найдены"
            android:textColor="@color/primary_text_color"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Проверьте наличие видеофайлов на устройстве"
            android:textColor="@color/player_item_inactive_text"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="@font/open_sans_semibold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Обновить"
            android:textColor="@color/white_color"
            app:backgroundTint="@color/accent_color"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent_color"
        android:visibility="gone" />

    <!-- Top Floating Controls: Action Buttons, Search, & Playlist Creation Bar -->
    <LinearLayout
        android:id="@+id/layoutTopControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Playlist Creation Bar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutPlaylistCreationBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/card_bg_color"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardPreventCornerOverlap="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvPlaylistSelectionCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Выбрано: 0 видео"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp"
                    android:fontFamily="@font/open_sans_bold" />

                <ImageButton
                    android:id="@+id/btnCancelPlaylist"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/player_item_inactive_text"
                    android:padding="6dp"
                    android:contentDescription="Отмена" />

                <ImageButton
                    android:id="@+id/btnDonePlaylist"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_check"
                    app:tint="@color/accent_color"
                    android:padding="4dp"
                    android:contentDescription="Готово" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Search & Action Buttons Container -->
        <FrameLayout
            android:id="@+id/layoutControlButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/layoutNormalButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Left Top Corner Tabs Container -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardVideoTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@color/card_bg_color"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="6dp"
                    app:cardPreventCornerOverlap="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tabRegularVideos"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_tab_pill_selected"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Обычные"
                            android:textColor="@color/white_color"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/open_sans_bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/tabShortVideos"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_tab_pill_unselected"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Короткие"
                            android:textColor="@color/player_item_inactive_text"
                            android:textSize="12.5sp"
                            android:fontFamily="@font/open_sans_bold"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Right Top Corner Action Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Create Playlist Button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/card_bg_color"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="6dp"
                        app:cardPreventCornerOverlap="false">

                        <ImageButton
                            android:id="@+id/btnCreatePlaylist"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_episodes"
                            app:tint="@color/accent_color"
                            android:padding="8dp"
                            android:contentDescription="Создать плейлист" />
                    </androidx.cardview.widget.CardView>

                    <!-- Sort Button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/card_bg_color"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="6dp"
                        app:cardPreventCornerOverlap="false">

                        <ImageButton
                            android:id="@+id/btnSort"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_sort_arrows"
                            app:tint="@color/primary_text_color"
                            android:padding="8dp"
                            android:contentDescription="Сортировка" />
                    </androidx.cardview.widget.CardView>

                    <!-- Search Toggle Button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        app:cardBackgroundColor="@color/card_bg_color"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="6dp"
                        app:cardPreventCornerOverlap="false">

                        <ImageButton
                            android:id="@+id/btnSearchToggle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_search"
                            app:tint="@color/primary_text_color"
                            android:padding="8dp"
                            android:contentDescription="Поиск" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Expanded Search Bar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutExpandedSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardCornerRadius="26dp"
                app:cardElevation="10dp"
                app:cardPreventCornerOverlap="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/accent_color"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/etSearchVideos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="Поиск видео..."
                        android:textColor="@color/primary_text_color"
                        android:textColorHint="@color/player_item_inactive_text"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />

                    <ImageButton
                        android:id="@+id/btnCloseSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        app:tint="@color/player_item_inactive_text"
                        android:padding="6dp"
                        android:contentDescription="Закрыть" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Floating Bar: Last Played Video & Folder Carousel -->
    <LinearLayout
        android:id="@+id/layoutFloatingExplorerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="76dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Last Played Video Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLastPlayedVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/card_bg_color"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <!-- Left: Preview Thumbnail -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLastPlayedThumbnail"
                    android:layout_width="92dp"
                    android:layout_height="54dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#0A0C14">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivLastPlayedThumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Превью видео" />

                        <!-- Mini duration pill -->
                        <TextView
                            android:id="@+id/tvLastPlayedDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_video_thumbnail_badge"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/white_color"
                            android:textSize="9sp"
                            android:fontFamily="@font/open_sans_bold"
                            android:visibility="gone" />

                        <!-- Mini percentage pill -->
                        <TextView
                            android:id="@+id/tvLastPlayedProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="3dp"
                            android:background="@drawable/bg_video_thumbnail_badge"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            android:textColor="@color/white_color"
                            android:textSize="9sp"
                            android:fontFamily="@font/open_sans_bold"
                            android:visibility="gone" />

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Middle: Video Title, Subtitle, and Progress -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLastPlayedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Название видео"
                        android:textColor="@color/primary_text_color"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvLastPlayedSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Продолжить • 12:45"
                        android:textColor="@color/player_item_inactive_text"
                        android:textSize="11sp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <com.example.animelib.ui.M3LinearProgressIndicator
                        android:id="@+id/pbLastPlayedProgress"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="5dp"
                        android:max="100"
                        android:progress="0"
                        app:m3TrackHeight="3.5dp"
                        app:m3GapSize="2.5dp"
                        app:m3StopDotSize="3dp"
                        app:m3ShowStopDot="true"
                        app:m3IndicatorColor="@color/accent_color"
                        app:m3TrackColor="@color/accent_color_alpha_25"
                        app:m3StopDotColor="@color/accent_color"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Right: Action Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Button 1: Play button -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnLastPlayedPlayCard"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false">

                        <ImageButton
                            android:id="@+id/btnLastPlayedPlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_player_play"
                            app:tint="@color/white_color"
                            android:padding="8dp"
                            android:contentDescription="Воспроизвести" />
                    </androidx.cardview.widget.CardView>

                    <!-- Button 2: Playlist button (only if in playlist) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnLastPlayedPlaylistCard"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="2dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/btnLastPlayedPlaylist"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_episodes"
                            app:tint="@color/white_color"
                            android:padding="8dp"
                            android:contentDescription="Плейлист" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Folder Carousel Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFolderCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            app:cardBackgroundColor="@color/card_bg_color"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardPreventCornerOverlap="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:clipToPadding="false"
                android:clipChildren="false" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>
