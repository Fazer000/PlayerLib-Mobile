<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryColor"
    android:fitsSystemWindows="false">

    <!-- Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/primaryColor"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/white_color" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Загрузка видео..."
            android:textColor="@color/app_text_primary"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Ambient Light Container (behind main video layout, full screen) -->
    <FrameLayout
        android:id="@+id/ambientContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="visible">

        <!-- Live Real-Time Texture View Sampler (Zero-lag Ambilight) -->
        <ImageView
            android:id="@+id/ambientImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <!-- Secondary Ambient Player View (blurred edge glow fallback) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/ambientPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:use_controller="false"
            app:surface_type="texture_view"
            app:resize_mode="zoom"
            app:show_buffering="never"
            app:shutter_background_color="@android:color/transparent" />

        <!-- Organic Vignette & Falloff Overlay for Ambient Light -->
        <com.example.animelib.ui.AmbientVignetteOverlayView
            android:id="@+id/ambientVignetteOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Main Video Layout (Holds Video Container and Portrait Bottom Space) -->
    <LinearLayout
        android:id="@+id/mainVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Video Player Container -->
        <com.example.animelib.ui.RoundedCornerFrameLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top|start">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view"
                app:animation_enabled="false"
                app:show_timeout="3000"
                app:controller_layout_id="@layout/custom_player_controller"
                app:repeat_toggle_modes="none"
                app:show_buffering="never"
                app:show_next_button="false"
                app:show_previous_button="false"
                app:show_shuffle_button="false"
                app:show_subtitle_button="false" />

            <!-- Standalone Buffering Indicator (Always visible when buffering, even when controls are hidden) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/playerBufferingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/accent_color"
                app:trackCornerRadius="8dp"
                app:trackThickness="4dp"
                app:indicatorSize="48dp"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false"
                android:elevation="30dp"
                android:translationZ="30dp" />

            <!-- Swipe seek preview -->
            <TextView
                android:id="@+id/seekPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="18dp"
                android:background="@drawable/video_time_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="+0 c"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Hold-to-speed plaque -->
            <TextView
                android:id="@+id/holdSpeedToast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="14dp"
                android:background="@drawable/video_time_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="2x"
                android:textColor="@color/player_item_inactive_text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Double tap skip indicator - Left (backward) -->
            <LinearLayout
                android:id="@+id/skipIndicatorLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="32dp"
                android:orientation="vertical"
                android:gravity="center"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/skipIconLeft"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_skip"
                    android:rotation="180"
                    android:alpha="0.9"
                    app:tint="@color/white_color" />

                <TextView
                    android:id="@+id/skipTextLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/video_time_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="-85 сек"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Double tap skip indicator - Right (forward) -->
            <LinearLayout
                android:id="@+id/skipIndicatorRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="32dp"
                android:orientation="vertical"
                android:gravity="center"
                android:alpha="0"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/skipIconRight"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_skip"
                    android:alpha="0.9"
                    app:tint="@color/white_color" />

                <TextView
                    android:id="@+id/skipTextRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/video_time_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="+85 сек"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Unified vertical gesture indicator plaque (Brightness & Volume) -->
            <LinearLayout
                android:id="@+id/gestureIndicatorPlaque"
                android:layout_width="125dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="16dp"
                android:background="@drawable/video_time_background"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/gestureIndicatorIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/white_color" />

                <ProgressBar
                    android:id="@+id/gestureIndicatorProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/bg_gesture_progress_bar" />

                <TextView
                    android:id="@+id/gestureIndicatorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|start"
                    android:text="100%"
                    android:textColor="@color/player_item_inactive_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Screen Lock Overlay (Landscape mode only, shows swipe unlock zone at bottom) -->
            <FrameLayout
                android:id="@+id/layoutLockedOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <!-- Lock Status Indicator (briefly shown when locked / tapped) -->
                <LinearLayout
                    android:id="@+id/lockedStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/video_time_background"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/ivLockedBadgeIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/white_color" />

                    <TextView
                        android:id="@+id/tvLockedBadgeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Экран заблокирован"
                        android:textColor="@color/white_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Interactive Swipe Pill (Directly in full-screen overlay to avoid clipping on drag) -->
                <LinearLayout
                    android:id="@+id/swipeUnlockPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_swipe_unlock_pill"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/ivSwipeChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="@color/white_color" />

                    <ImageView
                        android:id="@+id/ivSwipeLockIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/white_color" />

                    <TextView
                        android:id="@+id/tvSwipeUnlockText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Смахните вверх для разблокировки"
                        android:textColor="@color/white_color"
                        android:textSize="13sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

        </com.example.animelib.ui.RoundedCornerFrameLayout>

        <!-- Bottom Content below Player for Portrait Mode with playlist episodes list -->
        <LinearLayout
            android:id="@+id/portraitBottomContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="?attr/primaryColor"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <!-- Title & Info Header Card (Top Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPortraitTitleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimeLIB.TopCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvPortraitAnimeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Загрузка..."
                        android:textColor="@color/primary_text_color"
                        android:textSize="15sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- File Size & Date -->
                    <TextView
                        android:id="@+id/tvPortraitPlaylistInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Список серий плейлиста"
                        android:textColor="@color/player_item_inactive_text"
                        android:textSize="12sp"
                        android:fontFamily="@font/open_sans" />

                    <!-- Tags Row: New, Extension, Folder -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPortraitNewTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_new_badge"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/accent_color"
                            android:textSize="9.5sp"
                            android:fontFamily="@font/open_sans_bold"
                            android:text="НОВОЕ"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvPortraitFormatTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_search_pill_badge"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/player_item_inactive_text"
                            android:textSize="10sp"
                            android:fontFamily="@font/open_sans_bold"
                            android:text="MP4"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvPortraitFolderTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_search_pill_badge"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/player_item_inactive_text"
                            android:textSize="10sp"
                            android:fontFamily="@font/open_sans_semibold"
                            android:text="Downloads"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Episodes Section Header Card (Bottom Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPortraitEpisodesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/card_bg_color"
                app:cardElevation="6dp"
                app:strokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimeLIB.BottomCard">

                <LinearLayout
                    android:id="@+id/layoutPortraitEpisodesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tvPortraitEpisodesHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Серии плейлиста"
                        android:textColor="@color/primary_text_color"
                        android:textSize="14sp"
                        android:fontFamily="@font/open_sans_bold" />

                    <TextView
                        android:id="@+id/tvPortraitEpisodesCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_video_thumbnail_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="1 / 1"
                        android:textColor="@color/accent_color"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/open_sans_bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Episodes RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylistEpisodes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
